# Copiar a .env y completar con los valores del proyecto Supabase
# (Supabase Dashboard > Project Settings > Data API / API Keys).
# VITE_SUPABASE_URL es la URL base del proyecto (sin /rest/v1/ ni ninguna
# otra ruta al final) — el cliente de Supabase agrega esas rutas solo.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
